---
import { content, type Lang } from '../i18n/content';
import { WHATSAPP_NUMBER } from '../config';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = content[lang].cards;
const config = {
  number: WHATSAPP_NUMBER,
  lang,
  decks: t.decks,
  positions: t.positions,
  deckNames: { egyptian: t.egyptian, spanish: t.spanish },
  again: t.again,
  draw: t.draw,
  waMsg: t.waMsg,
};
---

<div id="reader" data-config={JSON.stringify(config)}>
  <div class="mx-auto mb-8 flex w-fit rounded-full border border-gold/40 bg-white/60 p-1" role="tablist">
    <button type="button" data-deck="egyptian" class="deck-btn rounded-full px-5 py-2 text-sm font-medium transition">
      {t.egyptian}
    </button>
    <button type="button" data-deck="spanish" class="deck-btn rounded-full px-5 py-2 text-sm font-medium transition">
      {t.spanish}
    </button>
  </div>

  <div class="grid grid-cols-3 gap-3 sm:gap-8">
    {
      t.positions.map((pos, i) => (
        <div class="text-center">
          <p class="mb-3 text-xs font-medium uppercase tracking-[0.2em] text-plum-soft">{pos}</p>
          <div class="card-scene mx-auto aspect-[2/3] w-full max-w-[220px]">
            <div class="card-inner relative h-full w-full" data-slot={i}>
              <div class="card-face card-back-face absolute inset-0 overflow-hidden rounded-[14px] shadow-xl shadow-plum/30" />
              <div class="card-face card-front absolute inset-0 overflow-hidden rounded-[14px] shadow-xl shadow-plum/30" />
            </div>
          </div>
          <p class="slot-name mt-3 min-h-[1.5em] font-display text-base font-semibold sm:text-lg" />
        </div>
      ))
    }
  </div>

  <div id="meanings" class="mx-auto mt-8 max-w-xl space-y-2 text-center text-sm leading-relaxed text-plum-soft sm:text-base"></div>

  <div class="mt-8 flex flex-col items-center gap-4">
    <button
      id="draw"
      type="button"
      class="rounded-full bg-turquoise px-8 py-3 font-medium text-white shadow transition hover:bg-turquoise-deep"
    >
      {t.draw}
    </button>
    <div id="cta-wrap" class="hidden flex-col items-center gap-2">
      <a
        id="reader-cta"
        href="#"
        target="_blank"
        rel="noopener"
        class="animate-pulse-ring inline-flex items-center gap-2 rounded-full bg-[#25D366] px-8 py-4 text-center font-semibold text-white shadow-lg transition hover:brightness-95"
      >
        {t.cta}
      </a>
      <p class="max-w-sm text-center text-xs text-plum-soft">{t.ctaHint}</p>
    </div>
    <p class="text-xs text-plum-soft">{t.note}</p>
  </div>
</div>

<script>
  import { spanishCard, egyptianCard, cardBack } from '../lib/cards';

  type CardData = { id: string; name: string; meaning: string };
  const root = document.getElementById('reader')!;
  const cfg = JSON.parse(root.dataset.config!) as {
    number: string;
    lang: 'es' | 'en';
    decks: Record<'egyptian' | 'spanish', CardData[]>;
    positions: string[];
    deckNames: Record<'egyptian' | 'spanish', string>;
    again: string;
    draw: string;
    waMsg: string;
  };

  let deck: 'egyptian' | 'spanish' = 'egyptian';
  const btns = root.querySelectorAll<HTMLButtonElement>('.deck-btn');
  const drawBtn = document.getElementById('draw')!;
  const ctaWrap = document.getElementById('cta-wrap')!;
  const cta = document.getElementById('reader-cta') as HTMLAnchorElement;
  const meanings = document.getElementById('meanings')!;
  const inners = root.querySelectorAll<HTMLElement>('.card-inner');

  const paintBacks = () =>
    inners.forEach((el) => {
      el.querySelector('.card-back-face')!.innerHTML = cardBack(deck);
    });

  const paintTabs = () =>
    btns.forEach((b) => {
      const on = b.dataset.deck === deck;
      b.classList.toggle('bg-plum', on);
      b.classList.toggle('text-ivory', on);
      b.classList.toggle('text-plum', !on);
    });

  const reset = () => {
    inners.forEach((el) => {
      el.classList.remove('is-flipped');
      el.parentElement!.parentElement!.querySelector('.slot-name')!.textContent = '';
    });
    ctaWrap.classList.add('hidden');
    ctaWrap.classList.remove('flex');
    meanings.innerHTML = '';
    drawBtn.textContent = cfg.draw;
  };

  const buildWhatsApp = (pool: CardData[]) => {
    const list = pool.map((c, i) => `• ${cfg.positions[i]}: ${c.name}`).join('\n');
    const msg = cfg.waMsg.replace('{deck}', cfg.deckNames[deck]).replace('{cards}', list);
    return `https://wa.me/${cfg.number}?text=${encodeURIComponent(msg)}`;
  };

  btns.forEach((b) =>
    b.addEventListener('click', () => {
      deck = b.dataset.deck as typeof deck;
      paintTabs();
      reset();
      paintBacks();
    }),
  );

  drawBtn.addEventListener('click', () => {
    reset();
    const pool = [...cfg.decks[deck]].sort(() => Math.random() - 0.5).slice(0, 3);
    setTimeout(() => {
      inners.forEach((el, i) => {
        const c = pool[i];
        el.querySelector('.card-front')!.innerHTML = deck === 'egyptian' ? egyptianCard(c.id, cfg.lang) : spanishCard(c.id, cfg.lang);
        el.parentElement!.parentElement!.querySelector('.slot-name')!.textContent = c.name;
        setTimeout(() => el.classList.add('is-flipped'), i * 350);
      });
      meanings.innerHTML = pool
        .map((c, i) => `<p><strong class="font-display text-lg text-plum">${cfg.positions[i]} · ${c.name}</strong><br/>${c.meaning}</p>`)
        .join('');
      cta.href = buildWhatsApp(pool);
      ctaWrap.classList.remove('hidden');
      ctaWrap.classList.add('flex');
      drawBtn.textContent = cfg.again;
    }, 450);
  });

  paintTabs();
  paintBacks();
</script>
